<?xml version="1.0" encoding="UTF-8"?>
<?import com.jfoenix.controls.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<?import javafx.scene.control.Label?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.kosolapova.javafx.validation.controllers.ErrorDialogController"
      spacing="20"
      style="-fx-background-color: #ffffff; -fx-border-radius: 12px; -fx-padding: 20;">

    <!-- Отступы -->
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <!-- Заголовок (стилизованный JFXLabel) -->
    <Label fx:id="lblTitle"
           text="Ошибка"
           styleClass="headline"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #e53935;"/>

    <!-- Сообщение об ошибке (многострочное) -->
    <Label fx:id="lblMessage"
              wrapText="true"
              style="-fx-font-size: 14px; -fx-text-fill: #424242; -fx-line-spacing: 5;"/>

    <!-- Инструкция -->
    <Label text="Нажмите OK, чтобы закрыть."
              style="-fx-font-size: 13px; -fx-text-fill: #757575;"/>

    <!-- Кнопка OK (стилизованная JFXButton) -->
    <JFXButton fx:id="btnOK"
               text="OK"
               onAction="#onOKClicked"
               buttonType="RAISED"
               styleClass="button-raised"
               style="-fx-background-color: #1a73e8; -fx-text-fill: white;"
               prefWidth="100"
               alignment="CENTER">
    </JFXButton>

</VBox>
