<?xml version="1.0" encoding="UTF-8"?>
<?import com.jfoenix.controls.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.kosolapova.javafx.validation.controllers.ValidationInlineController"
      spacing="15"
      style="-fx-background-color: #f5f5f5;">

    <!-- Отступы вокруг содержимого -->
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>


    <!-- Заголовок -->
    <Label text="Форма ввода с мгновенной валидацией"
           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 0 0 15 0;">
    </Label>

    <!-- Поле "Имя" -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label text="Имя:" style="-fx-font-weight: 500; -fx-padding: 0 5 0 0;"/>
        <JFXTextField fx:id="txtName"
                      promptText="Введите имя"
                      prefWidth="250"
                      styleClass="text-field"/>
        <Label fx:id="lblNameError"
               styleClass="label-error"
               prefWidth="250"
               style="-fx-font-size: 12px;"/>
    </HBox>

    <!-- Поле "Пароль" -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label text="Пароль:" style="-fx-font-weight: 500; -fx-padding: 0 5 0 0;"/>
        <JFXPasswordField fx:id="pwdPassword"
                          promptText="Введите пароль"
                          prefWidth="250"
                          styleClass="password-field"/>
        <Label fx:id="lblPwdError"
               styleClass="label-error"
               prefWidth="250"
               style="-fx-font-size: 12px;"/>
    </HBox>

    <!-- Список выбора -->
    <HBox spacing="15" alignment="TOP_LEFT">
        <Label text="Выбор пунктов:" style="-fx-font-weight: 500; -fx-padding: 5 5 0 0;"/>
        <VBox>
            <JFXListView fx:id="lstSelections"
                         prefHeight="120"
                         prefWidth="200"
                         styleClass="list-view"/>
            <Label fx:id="lblLstError"
                   styleClass="label-error"
                   style="-fx-font-size: 11px; -fx-padding: 5 0 0 0;"/>
        </VBox>
    </HBox>

    <!-- Чекбокс "Согласие" -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <JFXCheckBox fx:id="chkAgreement"
                     text="Я согласен"
                     styleClass="check-box"/>
        <Label fx:id="lblChkError"
               styleClass="label-error"
               style="-fx-font-size: 12px;"/>
    </HBox>
</VBox>
